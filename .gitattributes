# https://git-scm.com/docs/gitattributes

# Detect text files and normalize line endings to LF, on commit and checkout
* text=auto eol=lf

# Binary assets, never diff or attempt to merge
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.woff  binary
*.woff2 binary

# SVG is XML, keep it diffable
*.svg   text
